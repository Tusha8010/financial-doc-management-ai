{
  "info": {
    "name": "Financial Document Management System",
    "description": "Complete Postman collection for the Financial Document Management API with Semantic Search (RAG).\n\nWorkflow:\n1. Register → Login → Copy token\n2. Admin assigns Analyst role\n3. Upload PDF document\n4. Index document for RAG\n5. Perform semantic search",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000", "type": "string" },
    { "key": "access_token", "value": "", "type": "string" },
    { "key": "document_id", "value": "", "type": "string" },
    { "key": "user_id", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/auth/register" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"analyst@acme.com\",\n  \"username\": \"john_analyst\",\n  \"password\": \"SecurePass123!\",\n  \"full_name\": \"John Smith\"\n}"
            }
          }
        },
        {
          "name": "Register Admin User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/auth/register" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@acme.com\",\n  \"username\": \"admin_user\",\n  \"password\": \"AdminPass123!\",\n  \"full_name\": \"System Admin\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('access_token', body.access_token);",
                  "  console.log('Token saved:', body.access_token.substring(0, 30) + '...');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/auth/login" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"analyst@acme.com\",\n  \"password\": \"SecurePass123!\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "2. Roles & Permissions",
      "item": [
        {
          "name": "Create Role",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": { "raw": "{{base_url}}/roles/create" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"SeniorAnalyst\",\n  \"description\": \"Senior analyst with full document access\",\n  \"permission_names\": [\n    \"document:upload\",\n    \"document:view\",\n    \"document:edit\",\n    \"document:search\",\n    \"rag:index\",\n    \"rag:search\"\n  ]\n}"
            }
          }
        },
        {
          "name": "Assign Role to User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": { "raw": "{{base_url}}/users/assign-role" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"{{user_id}}\",\n  \"role_name\": \"Analyst\"\n}"
            }
          }
        },
        {
          "name": "Get User Roles",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{base_url}}/users/{{user_id}}/roles" }
          }
        },
        {
          "name": "Get User Permissions",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{base_url}}/users/{{user_id}}/permissions" }
          }
        },
        {
          "name": "List All Permissions",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{base_url}}/permissions" }
          }
        }
      ]
    },
    {
      "name": "3. Documents",
      "item": [
        {
          "name": "Upload Document (PDF)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('document_id', body.id);",
                  "  console.log('Document ID saved:', body.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{base_url}}/documents/upload" },
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": "/path/to/your/report.pdf" },
                { "key": "title", "value": "Q3 2024 Financial Report", "type": "text" },
                { "key": "company_name", "value": "Acme Corporation", "type": "text" },
                { "key": "document_type", "value": "report", "type": "text" },
                { "key": "description", "value": "Third quarter earnings and financial analysis", "type": "text" }
              ]
            }
          }
        },
        {
          "name": "Upload Invoice",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{base_url}}/documents/upload" },
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": "/path/to/invoice.pdf" },
                { "key": "title", "value": "Invoice #INV-2024-001", "type": "text" },
                { "key": "company_name", "value": "Tech Supplies Ltd", "type": "text" },
                { "key": "document_type", "value": "invoice", "type": "text" }
              ]
            }
          }
        },
        {
          "name": "List All Documents",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": {
              "raw": "{{base_url}}/documents?skip=0&limit=20",
              "query": [
                { "key": "skip", "value": "0" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Get Document by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{base_url}}/documents/{{document_id}}" }
          }
        },
        {
          "name": "Search Documents by Metadata",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": {
              "raw": "{{base_url}}/documents/search?company_name=Acme&document_type=report",
              "query": [
                { "key": "company_name", "value": "Acme" },
                { "key": "document_type", "value": "report" },
                { "key": "title", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Delete Document",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{base_url}}/documents/{{document_id}}" }
          }
        }
      ]
    },
    {
      "name": "4. RAG & Semantic Search",
      "item": [
        {
          "name": "Index Document",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": { "raw": "{{base_url}}/rag/index-document" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"document_id\": \"{{document_id}}\"\n}"
            }
          }
        },
        {
          "name": "Semantic Search - Debt Risk",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": { "raw": "{{base_url}}/rag/search" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"financial risk related to high debt ratio\",\n  \"top_k\": 5\n}"
            }
          }
        },
        {
          "name": "Semantic Search - Revenue Analysis",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": { "raw": "{{base_url}}/rag/search" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"quarterly revenue growth and profit margins\",\n  \"top_k\": 5,\n  \"company_name\": \"Acme Corporation\",\n  \"document_type\": \"report\"\n}"
            }
          }
        },
        {
          "name": "Semantic Search - Cash Flow",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": { "raw": "{{base_url}}/rag/search" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"cash flow from operations and working capital requirements\",\n  \"top_k\": 3\n}"
            }
          }
        },
        {
          "name": "Get Document Context",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{base_url}}/rag/context/{{document_id}}" }
          }
        },
        {
          "name": "Remove Document Embeddings",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{base_url}}/rag/remove-document/{{document_id}}" }
          }
        }
      ]
    },
    {
      "name": "5. System",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/health" }
          }
        },
        {
          "name": "API Docs",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/docs" }
          }
        }
      ]
    }
  ]
}
