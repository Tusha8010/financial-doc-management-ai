# Application
APP_NAME="Financial Document Management System"
APP_VERSION="1.0.0"
DEBUG=True

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/financial_docs_db

# JWT
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# Vector DB (FAISS)
FAISS_INDEX_PATH=./faiss_index

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Logging
LOG_LEVEL=INFO

